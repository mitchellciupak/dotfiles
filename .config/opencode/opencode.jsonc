{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "server": {
    "port": 4096,
  },
  "mcp": {
    "grafana-ai-dev": {
      "enabled": true,
      "type": "local",
      "command": ["uvx", "mcp-grafana"],
      "environment": {
        "GRAFANA_URL": "https://grafana.ai-dev.titanxdr.comcast.com",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{file:~/.certs/ai_grafana_dev.token}",
      },
    },
  },
  "tools": {
    "grafana-*": false
  },
  "agent": {
    "plan": {
        "disable": false
    },
    "build": {
        "disable": false
    },
  },
}